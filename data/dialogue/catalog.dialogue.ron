(
    profiles: [
        (
            id: "sella",
            name: "Sella",
            refusal: Some("I have a post to keep. Make it quick."),
            topics: [
                (id: "the_relay", label: "What are you guarding?", reply: Text("The hatch leads to the Old Relay. It was here before Nivalis had a name. I keep watch in case anything comes up from below.")),
                (id: "the_long_dark", label: "How is the watch?", reply: Text("Quiet, mostly. The ice carries sounds a long way at night. Sometimes I hear footsteps before I see anyone on the trail.")),
            ],
            replies: [],
        ),
        (
            id: "orren",
            name: "Orren",
            refusal: Some("I'm on watch. Keep moving."),
            topics: [
                (id: "the_trail", label: "What lies along the trail?", reply: Text("The blue waystones mark the safe route north. Stay between them. The shelf beyond is full of old cracks hidden under fresh snow.")),
                (id: "the_beacon", label: "Why guard Nivalis?", reply: Text("The beacon is how people find the outpost through the dark. While it is out, we keep the trail watched and the doors ready.")),
            ],
            replies: [],
        ),
        (
            // Match the speaker's Rust profile ID (PROFILE in src/nemi/dialogue.rs).
            id: "nemi",
            name: "Nemi",
            refusal: Some("Stay away from me."),
            topics: [
                // Quest topic IDs must match the registrations in register_topics in
                // src/nemi/dialogue.rs. Inline Text topics need a unique ID within this profile.
                (id: "last_light", label: "I'm here to help", reply: Quest),
                (id: "return_beacon_core", label: "I found the beacon core", reply: Quest),
                (id: "old_relay", label: "Tell me about the Old Relay", reply: Quest),
                (id: "report_archive_hushcap", label: "I saw a mushroom creature in the archive", reply: Quest),
                (id: "contain_the_hushcaps", label: "What should I do about the Hushcaps?", reply: Quest),
                (
                    id: "about_nemi",
                    label: "Tell me about yourself",
                    reply: Text("I keep the crossing light. In the long dark, I listen for families knocking at the beacon door to tell me they've made it home. Some nights, after everyone's accounted for, the ice knocks too."),
                ),
                (
                    id: "about_nivalis",
                    label: "Tell me about Nivalis",
                    reply: Text("Nivalis is the last warm door for a long way across the ice. In the long dark, the shelf sometimes gives you back your own footsteps from somewhere up ahead. Keep your eyes on the paired blue waystones. They'll bring you home."),
                ),
            ],
            replies: [
                // Each ID must exactly match the string in a ReplyId constant in
                // src/nemi/dialogue.rs. Update both places if you rename one.
                (
                    id: "relay_sealed",
                    text: "The round hatch northwest of the beacon tower leads to the Old Relay. The first survey crews sheltered down there. Once the beacon has power again, the hatch will open.",
                ),
                (
                    id: "relay_hatch",
                    text: "Look northwest of the beacon tower for a round hatch with a blue ring. The beacon has lit it again. Down there, the old lamps still remember the way the first survey crews took.",
                ),
                (
                    id: "relay_switch",
                    text: "Go north from the entry vestibule to the junction and follow the amber lamps east. The maintenance switch on the plinth opens the archive gate.",
                ),
                (
                    id: "relay_survey_log",
                    text: "Follow the blue lamps north from the junction and go through the raised gate. The first survey log is on a pedestal in front of the wall map.",
                ),
                (
                    id: "early_core_returned",
                    text: "You found the core in the blue cavern? Our beacon went dark, and families have been waiting to cross the ice. With this, I can light their way again.\n\nThe beacon also powers the Old Relay. Look for the round hatch west and a little south of here. Its archive may still hold the first survey log.\n\nQUEST COMPLETE / THE LAST LIGHT",
                ),
                (
                    id: "core_returned",
                    text: "There it is. I thought we had lost that light for good. The crossing has a light again.\n\nThe beacon also powers the Old Relay. Look for the round hatch west and a little south of here. Its archive may still hold the first survey log.\n\nQUEST COMPLETE / THE LAST LIGHT",
                ),
                (
                    id: "early_core_stored",
                    text: "You found the core in the blue cavern? Our beacon went dark, and families have been waiting to cross the ice. Bring the core to me when you have it with you.",
                ),
                (
                    id: "core_missing",
                    text: "Bring the beacon power core back to me first.",
                ),
                (
                    id: "beacon_briefing",
                    text: "We need to prepare before the long dark. Our beacon has gone silent. The families here depend on its signal to cross the ice.\n\nA charged core waits in the blue cavern, beyond the waystones. Follow their lights north, then bring it back.",
                ),
                (
                    id: "core_directions",
                    text: "Follow the blue waystones north from the outpost. The core is inside the cavern at the end of the trail.",
                ),
                (
                    id: "cavern_briefing",
                    text: "A Hushcap. Spores from South Basin have reached the gate approaches. The families can see our light, but the velliks won’t pull through a spore drift. Go south into the basin and follow the bend behind the ridge. Defeat five Hushcaps in the caverns. The gate will open when the drift thins. Bring five Mycelium samples for Tovan, the caravan’s craftsman.",
                ),
                (
                    id: "caravan_directions",
                    text: "The lamp over the southwest gate has changed. The families can come in. Once they’re home, look for Tovan at his tall-roofed workshop southwest of the beacon.",
                ),
                (
                    id: "cavern_directions",
                    text: "The caverns lie south, behind the ridge in South Basin. Defeat five Hushcaps inside. The southwest gate will open for the families.",
                ),
            ],
        ),
        (
            id: "isera",
            name: "Isera",
            topics: [
                (id: "crossing", label: "How did you find Nivalis?", reply: Text("We kept the beacon to our left. Halfway across, a second light kept pace on our right. Nobody looked at it twice.")),
            ],
        ),
        (
            id: "tovan",
            name: "Tovan",
            topics: [
                (id: "show_mycelium", label: "I brought Mycelium samples.", reply: Quest),
                (id: "craft", label: "What do you make?", reply: Text("I fit fired stone over old Relay alloy. The panels ring when I tap them. I know by ear which ones will hold through the long dark.")),
            ],
            replies: [
                (id: "samples_needed", text: "I need five together. Bring them in your pack and I can read which way the threads have grown."),
                (id: "samples_examined", text: "See where the pale threads turn inward? They were growing toward the warm gate channels. I know which seams to watch now. Keep the samples. They’ve told me what I needed.\n\nQUEST COMPLETE / CONTAIN THE HUSHCAPS"),
            ],
        ),
        (
            id: "vey",
            name: "Vey",
            topics: [
                (id: "velliks", label: "How do velliks find their footing?", reply: Text("Watch the forks above their heads. They lean toward sound ice. If they lean back toward you, hold still.")),
            ],
        ),
        (
            id: "orla",
            name: "Orla",
            topics: [
                (id: "home", label: "What did you miss about home?", reply: Text("Cloth in the wind. The click of a cup on fired stone. Out on the crossing, every sound tried to be a voice.")),
            ],
        ),
    ],
    notices: [
        (id: "crossing.station_needs_samples", text: "Tovan’s guide calls for five Mycelium samples side by side. Bring five in your pack."),
        (id: "crossing.station_verified", text: "Under the inspection light, all five samples bend inward. Tovan’s guide identifies that pattern as growth toward the warm gate channels. You record the finding and keep the samples.\n\nQUEST COMPLETE / CONTAIN THE HUSHCAPS"),
        // Notice IDs must exactly match the strings in the NoticeId constants in
        // src/interaction.rs (beacon) and src/dungeon.rs (Old Relay).
        (
            id: "beacon.core_recovered_solo",
            text: "POWER CORE RECOVERED\n\nInstall it in the socket at the south side of the beacon tower.",
        ),
        (
            id: "beacon.core_recovered_before_meeting",
            text: "POWER CORE RECOVERED\n\nIts light pulses against your hands. There is still warmth inside.\n\nSpeak to Nemi at the outpost about restoring the beacon.",
        ),
        (
            id: "beacon.core_recovered_after_meeting",
            text: "POWER CORE RECOVERED\n\nIts light pulses against your hands. There is still warmth inside.\n\nReturn to Nemi at the outpost to restore the beacon.",
        ),
        (
            id: "beacon.restored",
            text: "BEACON RESTORED\n\nThe core locks into the socket and the tower lights up. The Old Relay hatch northwest of the tower now has power.",
        ),
        (
            id: "beacon.socket_empty",
            text: "BEACON SOCKET\n\nThe socket needs a charged beacon core.",
        ),
        (
            id: "old_relay.survey_log",
            text: "SURVEY LOG / THE FIRST WATCH\n\nBefore there was a Nivalis, there was this room. We put the first lamps on the ice so the survey crews could find their way back in the long dark.\n\nThe beacon above us still sends the same signal. Its first meaning was simple. There is shelter here, and someone is waiting.\n\nMARGIN NOTE / If Hushcap spores foul the gate channels, keep the crossing closed. The colony grows in South Basin, behind the ridge beyond the ice fins. Thin five Hushcaps and the draft animals can cross. Keep five Mycelium samples for the caravan craftsman.",
        ),
        (
            id: "old_relay.sealed_hatch",
            text: "OLD RELAY\n\nThe hatch responds to the beacon. Restore the light to release the seal.",
        ),
        (
            id: "old_relay.archive_gate_open",
            text: "The archive gate is open.",
        ),
        (
            id: "old_relay.hatch_obstructed",
            text: "The hatch landing is obstructed.",
        ),
    ],
)
