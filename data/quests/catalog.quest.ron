[
    (
        id: "last_light",
        title: "The Last Light",
        completion_xp: 70,
        summary: "Nivalis's beacon has gone dark. The families crossing the ice depend on its light.",
        starts_when: [SessionStart],
        first_objective: "meet_nemi",
        interrupts: [
            (on: AttackedNemi, reason: "You attacked Nemi, and they will no longer help you. You can still restore the beacon yourself. See Relight the Beacon."),
        ],
        objectives: [
            (
                id: "meet_nemi",
                title: "Speak to Nemi",
                directions: "Step out of your tent and find Nemi in the courtyard, northeast of the tall beacon tower. Approach and use your Interact key.",
                transitions: [(when: Action(TalkedToNemi), to: Objective("recover_core"))],
            ),
            (
                id: "recover_core",
                title: "Recover the beacon core",
                directions: "Head north from Nivalis and follow the paired blue waystones over the ice shelf. They lead to a shallow cavern lined with blue crystals. The charged core rests on a stone plinth in the middle of the cavern.",
                transitions: [
                    (when: Action(RecoveredCore), to: Objective("return_core")),
                    (when: Occurred(RecoveredCore), to: Objective("return_core"), credit_early: true),
                ],
            ),
            (
                id: "return_core",
                title: "Bring the core back to Nemi",
                directions: "Follow the blue waystones south to Nivalis. Speak to Nemi northeast of the beacon tower with the core in your pack.",
                transitions: [(when: Action(ReturnedCore), to: Complete)],
            ),
        ],
        completion: "Nemi used the core to relight the beacon. Its signal guides travelers across the ice and powers the Old Relay.",
    ),
    (
        id: "relight_beacon",
        title: "Relight the Beacon",
        completion_xp: 70,
        summary: "The beacon can still be restored. A socket at the tower base takes the charged core.",
        starts_when: [QuestFailed("last_light")],
        first_objective: "recover_core",
        objectives: [
            (
                id: "recover_core",
                title: "Recover the beacon core",
                directions: "Follow the paired blue waystones north of Nivalis to the shallow cavern lined with blue crystals. Take the charged core from the stone plinth in the middle of the cavern.",
                transitions: [
                    (when: Action(RecoveredCore), to: Objective("install_core")),
                    (when: Occurred(RecoveredCore), to: Objective("install_core"), credit: false),
                ],
            ),
            (
                id: "install_core",
                title: "Install the core at the beacon",
                directions: "Follow the blue waystones south to Nivalis. Look for the metal socket on the south side of the tall beacon tower's base. Approach it with the core in your pack and use your Interact key.",
                transitions: [(when: Action(InstalledCore), to: Complete)],
            ),
        ],
        completion: "You installed the core and relit Nivalis's beacon. The round hatch just northwest of the beacon tower now leads down to the Old Relay.",
    ),
    (
        id: "old_relay",
        title: "Old Relay",
        completion_xp: 120,
        summary: "A sealed hatch beneath Nivalis leads to an archive that may hold the first survey log.",
        outpost_only: true,
        starts_when: [Action(InspectedSealedHatch), QuestCompleted("last_light"), QuestCompleted("relight_beacon")],
        first_objective: "power_hatch",
        objectives: [
            (
                id: "power_hatch",
                title: "Restore power to the hatch",
                directions: "The hatch draws power from Nivalis's beacon. Follow the beacon quest currently active in your journal to restore power.",
                transitions: [
                    (when: QuestCompleted("last_light"), to: Objective("enter_relay")),
                    (when: QuestCompleted("relight_beacon"), to: Objective("enter_relay")),
                ],
            ),
            (
                id: "enter_relay",
                title: "Enter the Old Relay",
                directions: "Look northwest of the tall beacon tower for a round metal hatch with a blue ring in the ice. Use your Interact key to descend.",
                transitions: [(when: Action(EnteredRelay), to: Objective("open_gate"))],
            ),
            (
                id: "open_gate",
                title: "Open the archive gate",
                directions: "If you're on the surface, reenter through the round hatch northwest of the beacon tower. From the vestibule, head north to the junction and follow the amber floor lights east. The maintenance switch is on the plinth against the far wall.",
                transitions: [(when: Action(OpenedArchiveGate), to: Objective("read_log"))],
            ),
            (
                id: "read_log",
                title: "Read the archive survey log",
                directions: "Return west to the junction, then head north through the raised gate between the blue lights. The survey log is on the central pedestal in front of the wall map. If you're on the surface, reenter through the round hatch northwest of the beacon tower.",
                transitions: [(when: Action(ReadSurveyLog), to: Complete)],
            ),
        ],
        completion: "The first survey log records how the beacon once guided survey crews to shelter. To return to Nivalis, head south through the archive gate and junction to the round hatch in the entry vestibule.",
    ),
]
